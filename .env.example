# API 키 암호화에 쓰는 마스터 키 (base64로 인코딩한 32바이트).
# 생성: python -m autocve.security.keyvault
# 이 값을 잃어버리면 저장된 API 키를 복호화할 수 없습니다. 안전한 곳에 백업하세요.
AUTOCVE_MASTER_KEY=

# 웹 UI 접근 비밀번호 (HTTP Basic, 사용자 이름 admin). 비워 두면 인증 없이 열립니다.
AUTOCVE_ADMIN_PASSWORD=

# Docker Compose 밖에서 실행할 때만 필요합니다.
# AUTOCVE_DATABASE_URL=postgresql+psycopg://autocve:autocve@localhost:5432/autocve
# AUTOCVE_REDIS_URL=redis://localhost:6379/0
