# AutoCVE 설정 파일
# 이 파일을 .env로 복사해 값을 채웁니다. ./run.sh up을 처음 실행하면 자동으로 복사하고
# 마스터 키와 DB 비밀번호를 만들어 넣습니다.
#
# - 빈 값은 "설정 안 함"입니다. 선택 항목은 비워 두면 웹 화면에서 설정할 수 있습니다.
# - API 키·알림·예산 항목에 값을 넣으면 시작할 때 DB에 반영되고, 웹 화면에서는 바꿀 수 없게 잠깁니다.
#   값을 바꾸면 ./run.sh restart로 다시 시작하세요. 값을 지우면 .env에서 넣었던 키는 DB에서도 지워집니다.
# - 이 파일에는 비밀 값이 들어갑니다. 저장소에 올리지 말고 권한을 600으로 두세요.

# =============================================================================
# 필수
# =============================================================================

# API 키 암호화에 쓰는 마스터 키 (base64로 인코딩한 32바이트).
# 생성: python3 -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
# 이 값을 잃어버리면 저장된 API 키를 복호화할 수 없습니다. 안전한 곳에 백업하세요.
AUTOCVE_MASTER_KEY=

# =============================================================================
# 접속
# =============================================================================

# 웹 UI 비밀번호 (HTTP Basic, 사용자 이름 admin). 비워 두면 인증 없이 열립니다.
# AUTOCVE_BIND를 0.0.0.0으로 열 때는 반드시 설정하세요.
AUTOCVE_ADMIN_PASSWORD=

# 웹 UI를 열 주소와 포트 (Docker Compose). 기본값은 같은 PC에서만 접속하는 127.0.0.1:8000.
AUTOCVE_BIND=127.0.0.1
AUTOCVE_PORT=8000

# 알림 속 링크에 쓰는 웹 UI 주소
AUTOCVE_PUBLIC_URL=http://127.0.0.1:8000

# 로그 수준: DEBUG, INFO, WARNING, ERROR
AUTOCVE_LOG_LEVEL=INFO

# =============================================================================
# API 키
# =============================================================================

# Anthropic API 키 (sk-ant-...). 취약점 프로파일 추출과 Haiku/Sonnet/Opus 분석에 씁니다.
# 비워 두면 웹 화면(설정 > API 키)에서 입력합니다.
AUTOCVE_ANTHROPIC_API_KEY=

# JEV 판별 모델 제공자: none(규칙 기반), typesafe, openrouter
# 비워 두면 웹 화면에서 고릅니다.
AUTOCVE_JEV_PROVIDER=
# TypeSafe에 직접 호출할 때의 키
AUTOCVE_TYPESAFE_API_KEY=
# OpenRouter를 거쳐 호출할 때의 키 (sk-or-...)
AUTOCVE_OPENROUTER_API_KEY=

# GitHub 토큰. 비공개 저장소를 clone할 때만 씁니다.
# 읽기 전용(Contents: Read) fine-grained 토큰을 권장합니다. github.com 저장소에만 전송합니다.
AUTOCVE_GITHUB_TOKEN=

# =============================================================================
# 예산
# =============================================================================

# Claude 월 예산 (USD). 80%를 넘으면 Opus 대신 Sonnet을 쓰고, 100%가 되면 Claude 호출을 멈춥니다.
# 비워 두면 웹 화면에서 정합니다 (기본은 제한 없음).
AUTOCVE_MONTHLY_BUDGET_USD=

# =============================================================================
# 알림
# =============================================================================

# 즉시 알림 기준: high(High 이상) 또는 critical(Critical만). 그 아래 등급은 일일 요약으로 보냅니다.
AUTOCVE_NOTIFY_IMMEDIATE_GRADE=
# 일일 요약 보내기: true 또는 false
AUTOCVE_NOTIFY_DIGEST=

# Slack Incoming Webhook 주소 (https://hooks.slack.com/services/...)
AUTOCVE_SLACK_WEBHOOK_URL=

# 이메일 받는 사람 (쉼표로 구분)
AUTOCVE_NOTIFY_EMAIL_TO=
# 이메일 발송 SMTP. HOST와 FROM이 없으면 이메일을 보내지 않습니다.
AUTOCVE_SMTP_HOST=
AUTOCVE_SMTP_PORT=587
AUTOCVE_SMTP_USERNAME=
AUTOCVE_SMTP_PASSWORD=
AUTOCVE_SMTP_FROM=
AUTOCVE_SMTP_STARTTLS=true

# =============================================================================
# 데이터베이스와 큐
# =============================================================================

# Docker Compose의 PostgreSQL 비밀번호. DB를 처음 만들 때만 적용되므로 그 뒤에는 바꾸지 마세요.
# 영문·숫자만 쓰세요 (DB 접속 주소에 그대로 들어갑니다).
AUTOCVE_DB_PASSWORD=

# Docker Compose 밖에서 실행할 때(./run.sh dev)만 씁니다. Compose에서는 위 비밀번호로 자동 설정됩니다.
# AUTOCVE_DATABASE_URL=postgresql+psycopg://autocve:autocve@localhost:5432/autocve
# AUTOCVE_REDIS_URL=redis://localhost:6379/0

# =============================================================================
# 고급 (보통은 바꿀 필요 없음)
# =============================================================================

# Docker 이미지. 배포 번들에서는 번들 버전으로 정해져 있습니다.
# AUTOCVE_IMAGE=autocve:local

# JEV 모델 ID. 임계값 보정이 모델 버전에 묶이므로 운영에서는 버전을 고정하세요.
# AUTOCVE_JEV_TYPESAFE_MODEL=jev-latest
# AUTOCVE_JEV_OPENROUTER_MODEL=typesafe/jev-1.14
# AUTOCVE_TYPESAFE_BASE_URL=https://api.typesafe.ai/v1
# AUTOCVE_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# 취약점 피드 주소
# AUTOCVE_OSV_BASE_URL=https://osv-vulnerabilities.storage.googleapis.com
# AUTOCVE_EPSS_URL=https://epss.empiricalsecurity.com/epss_scores-current.csv.gz
# AUTOCVE_KEV_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json
# AUTOCVE_GITHUB_API_URL=https://api.github.com

# 저장소 clone 작업 디렉터리. 비우면 시스템 임시 디렉터리를 씁니다.
# AUTOCVE_SCAN_WORKDIR=
